# Backend — complète le .env RACINE (../.env) qui contient déjà Google Sheets.
# Le serveur charge d’abord ../.env puis ce fichier (override).

JWT_SECRET=change-me-in-production
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://happyletsgo.fr,https://www.happyletsgo.fr

# ── Email Brevo ──
# PROD Render (plan free) : SMTP port 587 BLOQUÉ → utiliser BREVO_API_KEY (HTTPS)
# 1. https://www.brevo.com → Paramètres → SMTP & API → clé API v3 (xkeysib-…)
# 2. Vérifier l'expéditeur / domaine happyletsgo.fr
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=Happy Let's GO <noreply@happyletsgo.fr>

# Dev local (optionnel — SMTP si pas de BREVO_API_KEY)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key

APP_PUBLIC_URL=https://happyletsgo.fr

# Lecture de skipEmailVerification depuis l'onglet app_config (export CSV public du Sheet)
# Ex. https://docs.google.com/spreadsheets/d/XXX/export?format=csv&gid=GID_APP_CONFIG
APP_CONFIG_CSV_URL=
# Secours immédiat sans email : valide les comptes sans lien de vérification
SKIP_EMAIL_VERIFICATION=false

# ── Google Sheets : PAS besoin de dupliquer si déjà dans ../.env ───────────
# Le backend lit les mêmes variables que le front :
#   VITE_GOOGLE_SHEETS_URL_ENCODED
#   VITE_GOOGLE_SHEETS_API_URL
#   VITE_SHEET_GID_VIEWER_SETTINGS, VITE_SHEET_GID_MESSAGES, etc.
#
# Optionnel — onglet push (ajouter le gid si tu utilises Web Push) :
# VITE_SHEET_GID_PUSH_SUBSCRIPTIONS=

# Optionnel — Web Push (npm run vapid)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@happyletsgo.fr
